{
  "name": "checkout-ui-settings",
  "version": "0.1.0",
  "description": "VTEX Checkout UI customization with webpack, preact, and sass",
  "main": "index.js",
  "scripts": {
    "build": "webpack --mode=production",
    "build:dev": "webpack --mode=development",
    "watch": "webpack --mode=development --watch",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,scss,css}\"",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\""
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "babel-loader": "^9.1.0",
    "css-loader": "^6.8.0",
    "mini-css-extract-plugin": "^2.7.0",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.0"
  },
  "dependencies": {
    "preact": "^10.19.0"
  }
}